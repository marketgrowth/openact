{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openact-demo",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": { "enabled": true },

  // The public demo app. Workers Builds deploys the demo branch here on each push.
  // The landing page at openact.ing is a separate Worker in landing/.
  "routes": [{ "pattern": "a.openact.ing", "custom_domain": true }],

  // The web app is built by Vite into dist/client. The Worker answers /api/* and Docs share links (/docs/s/*) first.
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/docs/s/*"]
  },

  // Users, projects, members, tasks and sessions.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openact-demo",
      "database_id": "a646fb17-4f20-4efe-ad4e-6060d01af153",
      "migrations_dir": ".openact/migrations"
    }
  ],

  // Task attachments.
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "openact-demo-files"
    }
  ],

  // Live updates: one Durable Object per project holds its open WebSockets.
  // Docs live editing: one Durable Object per doc holds the shared doc and its editors. Without DOCS_ROOMS, Docs saves the usual way.
  "durable_objects": {
    "bindings": [
      { "name": "PROJECT_ROOMS", "class_name": "ProjectRoom" },
      { "name": "DOCS_ROOMS", "class_name": "DocsRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ProjectRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["DocsRoom"] }
  ],

  // Search by meaning. Create the index once with: npm run search:setup
  // 768 dimensions, cosine, for @cf/baai/bge-base-en-v1.5.
  "vectorize": [
    {
      "binding": "VECTORS",
      "index_name": "openact-tasks",
      "remote": true
    }
  ],

  // Workers AI. Requests go through AI Gateway when AI_GATEWAY_ID is set.
  "ai": { "binding": "AI", "remote": true },

  // The demo reset runs at 17 10 * * * (src/server/demo.ts).
  // Daily clean-up of expired sign-in codes and sessions, and search indexing every 10 minutes.
  "triggers": { "crons": ["17 3 * * *", "*/10 * * * *", "17 10 * * *"] },

  "vars": {
    "APP_NAME": "OpenAct Demo",
    "SUPER_ADMIN_EMAILS": "victor@marketgrowth.io",
    "APP_URL": "https://a.openact.ing",
    "EMAIL_FROM": "OpenAct Demo <no-reply@openact.ing>",
    "SIGNUP_MODE": "open",
    "ALLOWED_EMAIL_DOMAINS": "",
    "AI_PROVIDER": "workers-ai",
    "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "AI_SCOPE_MODEL": "",
    "TYPESAFE_MODEL": "jev-1.14.0",
    "TYPESAFE_BASE_URL": "",
    "AI_GATEWAY_ID": "openact",
    "CF_ACCOUNT_ID": "7ba24483701aad5568d7f9db0d81c3f7",
    // Deletes all demo data each night. See src/server/demo.ts.
    "DEMO_RESET": "true",
    // The reset keeps these companies when a super admin owns them.
    "DEMO_KEEP_COMPANIES": "MarketGrowth"
  }
}
