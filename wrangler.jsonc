{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openact",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": { "enabled": true },

  // The web app is built by Vite into dist/client. The Worker answers /api/* first.
  // Agent access (docs/agent-access.md) also needs the well-known files, the OAuth endpoints and /mcp.
  // The consent page, /oauth/authorize, is part of the web app.
  // An app with public pages of its own adds them here, such as "/docs/s/*" for Docs share links.
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/.well-known/*", "/oauth/register", "/oauth/token", "/oauth/revoke", "/mcp", "/mcp/*"]
  },

  // Users, projects, members, tasks and sessions.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openact",
      "migrations_dir": ".openact/migrations"
    }
  ],

  // Task attachments.
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "openact-files"
    }
  ],

  // Live updates: one Durable Object per project holds its open WebSockets.
  // An app with its own Durable Object adds a binding and a migration here. `npm run sync` checks them.
  "durable_objects": {
    "bindings": [
      { "name": "PROJECT_ROOMS", "class_name": "ProjectRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ProjectRoom"] }
  ],

  // Search by meaning. Create the index once with: npm run search:setup
  // 768 dimensions, cosine, for @cf/baai/bge-base-en-v1.5.
  "vectorize": [
    {
      "binding": "VECTORS",
      "index_name": "openact-tasks",
      "remote": true
    }
  ],

  // Workers AI. Requests go through AI Gateway when AI_GATEWAY_ID is set.
  "ai": { "binding": "AI", "remote": true },

  // Daily clean-up of expired sign-in codes and sessions, and search indexing every 10 minutes.
  "triggers": { "crons": ["17 3 * * *", "*/10 * * * *"] },

  "vars": {
    "APP_NAME": "OpenAct",
    "SUPER_ADMIN_EMAILS": "",
    "APP_URL": "",
    "EMAIL_FROM": "OpenAct <no-reply@example.com>",
    "SIGNUP_MODE": "open",
    "ALLOWED_EMAIL_DOMAINS": "",
    "AI_PROVIDER": "workers-ai",
    "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "AI_SCOPE_MODEL": "",
    "TYPESAFE_MODEL": "jev-1.14.0",
    "TYPESAFE_BASE_URL": "",
    "AI_GATEWAY_ID": "openact",
    "CF_ACCOUNT_ID": "",
    // "on" lets AI agents sign in with OAuth 2.1 and use the apps' tools at /mcp. See docs/agent-access.md.
    "AGENT_ACCESS": ""
  }
}
