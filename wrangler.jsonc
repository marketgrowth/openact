{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openact-on",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": { "enabled": true },

  // The web app is built by Vite into dist/client. The Worker answers /api/* and Docs share links (/docs/s/*) first.
  // MarketGrowth's private deploy at on.openact.ing, with only the License Keys app. Workers Builds deploys
  // the `on` branch here on each push. See ON.md. Do not merge this branch into main.
  "routes": [{ "pattern": "on.openact.ing", "custom_domain": true }],

  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/docs/s/*"]
  },

  // Users, projects, members, tasks and sessions.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openact-on",
      "migrations_dir": ".openact/migrations"
    }
  ],

  // Task attachments.
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "openact-on-files"
    }
  ],

  // Live updates: one Durable Object per project holds its open WebSockets.
  // Docs live editing: one Durable Object per doc holds the shared doc and its editors. Without DOCS_ROOMS, Docs saves the usual way.
  "durable_objects": {
    "bindings": [
      { "name": "PROJECT_ROOMS", "class_name": "ProjectRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ProjectRoom"] }
  ],

  // Workers AI. Requests go through AI Gateway when AI_GATEWAY_ID is set.
  "ai": { "binding": "AI", "remote": true },

  // Daily clean-up of expired sign-in codes and sessions, and search indexing every 10 minutes.
  "triggers": { "crons": ["17 3 * * *", "*/10 * * * *"] },

  "vars": {
    "APP_NAME": "OpenAct On",
    "SUPER_ADMIN_EMAILS": "victor@marketgrowth.io",
    "APP_URL": "https://on.openact.ing",
    "EMAIL_FROM": "OpenAct On <no-reply@openact.ing>",
    "SIGNUP_MODE": "open",
    "ALLOWED_EMAIL_DOMAINS": "marketgrowth.io",
    "AI_PROVIDER": "workers-ai",
    "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "AI_SCOPE_MODEL": "",
    "TYPESAFE_MODEL": "jev-1.14.0",
    "TYPESAFE_BASE_URL": "",
    "AI_GATEWAY_ID": "openact",
    "CF_ACCOUNT_ID": ""
  }
}
