{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openact",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": { "enabled": true },

  // The web app is built by Vite into dist/client. The Worker answers /api/* first.
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // Users, projects, members, tasks and sessions.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openact",
      "migrations_dir": "migrations"
    }
  ],

  // Task attachments.
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "openact-files"
    }
  ],

  // Live updates: one Durable Object per project holds its open WebSockets.
  "durable_objects": {
    "bindings": [{ "name": "PROJECT_ROOMS", "class_name": "ProjectRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ProjectRoom"] }],

  // Search by meaning. Create the index once with: npm run search:setup
  // 768 dimensions, cosine, for @cf/baai/bge-base-en-v1.5.
  "vectorize": [
    {
      "binding": "VECTORS",
      "index_name": "openact-tasks",
      "remote": true
    }
  ],

  // Workers AI. Requests go through AI Gateway when AI_GATEWAY_ID is set.
  "ai": { "binding": "AI", "remote": true },

  // Daily clean-up of expired sign-in codes and sessions, and search indexing every 10 minutes.
  "triggers": { "crons": ["17 3 * * *", "*/10 * * * *"] },

  "vars": {
    "APP_NAME": "OpenAct",
    "APP_URL": "",
    "EMAIL_FROM": "OpenAct <no-reply@example.com>",
    "SIGNUP_MODE": "open",
    "ALLOWED_EMAIL_DOMAINS": "",
    "AI_PROVIDER": "workers-ai",
    "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "AI_SCOPE_MODEL": "",
    "TYPESAFE_MODEL": "jev-1.14.0",
    "TYPESAFE_BASE_URL": "",
    "AI_GATEWAY_ID": "openact",
    "CF_ACCOUNT_ID": ""
  }
}
