{
  "$comment": "Made by `npm run design -- build` from packages/ui/promptbook.json and packages/ui/src/theme.css in https://github.com/marketgrowth/openact. Do not edit this copy.",
  "name": "OpenAct Promptbook",
  "version": "1.0.0",
  "url": "https://openact.ing/design",
  "source": "packages/ui/src/theme.css",
  "premise": "In a theater, the prompt book is the stage manager's master copy of the show. It holds the script, every cue and every move. The crew works from it. The Promptbook does the same job for OpenAct apps. It holds the tokens, the rules and the checks in one place. Agents read it first. People approve what the agents make.",
  "principles": [
    {
      "id": "agents-first",
      "title": "Written for agents first",
      "text": "The source is a JSON file and a Markdown file, not a picture. An agent can read every rule. A person can read every rule too."
    },
    {
      "id": "intent",
      "title": "Intent, not values",
      "text": "Pick a token by what it means. Use status-done for a done task. Never pick a green because it looks good. The values can change. The meaning stays."
    },
    {
      "id": "seeds",
      "title": "Seeds, not palettes",
      "text": "A new app gives one seed: a hue. The design script makes the light and dark values and tests their contrast. Agents do not invent palettes."
    },
    {
      "id": "agent-states",
      "title": "Agents have their own states",
      "text": "Agent work has five states: think, act, wait, done and fail. Each state has its own token and icon. A person can always see what the agent does."
    },
    {
      "id": "checks",
      "title": "Every rule has a check",
      "text": "A rule is a cue. Each cue has a check: a script, a test or a review by a person. The script runs with the unit tests."
    }
  ],
