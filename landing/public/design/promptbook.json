  "agentStates": [
    {
      "id": "think",
      "token": "agent-think",
      "icon": "dots",
      "label": "Reading",
      "rule": "Show what the agent reads, such as \"Reading 12 tasks\". Pulse slowly. Stop the pulse for reduced motion."
    },
    {
      "id": "act",
      "token": "agent-act",
      "icon": "bot",
      "label": "Running",
      "rule": "Name the tool in plain words, such as \"Moving 3 tasks\". Show one step at a time."
    },
    {
      "id": "wait",
      "token": "agent-wait",
      "icon": "shield",
      "label": "Waiting for you",
      "rule": "Show the change in plain words with Approve and Reject buttons. Deletes and people changes always wait. The agent never goes past this state on its own."
    },
    {
      "id": "done",
      "token": "agent-done",
      "icon": "check",
      "label": "Done",
      "rule": "Say what changed. Link to the changed item when you can."
    },
    {
      "id": "fail",
      "token": "agent-fail",
      "icon": "x",
      "label": "Stopped",
      "rule": "Say what went wrong and what to do next."
    }
  ],
  "type": {
    "sans": "Geist",
    "mono": "Geist Mono",
    "roles": [
      {
        "id": "label",
        "use": "Section labels and table heads.",
        "classes": "font-mono text-[11px] uppercase tracking-wider text-muted-foreground"
      },
      {
        "id": "body",
        "use": "Most text.",
        "classes": "text-sm"
      },
      {
        "id": "title",
        "use": "Card and dialog titles.",
        "classes": "text-base font-semibold"
      },
      {
        "id": "heading",
        "use": "The page title in SiteHeader.",
        "classes": "text-lg font-semibold tracking-tight"
      },
      {
        "id": "number",
        "use": "Dates, counts and money.",
        "classes": "tabular"
      }
    ]
  },
  "shape": {
    "radius": {
      "sm": "6px",
      "md": "8px",
      "lg": "10px",
      "xl": "14px"
    },
    "use": "Use rounded-md for controls, rounded-lg for cards and rounded-full for avatars and pills."
  },
  "motion": {
    "tokens": {
      "ease-enter": "cubic-bezier(0.22, 1, 0.36, 1)",
      "ease-exit": "cubic-bezier(0.55, 0, 1, 0.45)",
      "ease-move": "cubic-bezier(0.65, 0, 0.35, 1)",
      "motion-fast": "120ms",
      "motion-base": "200ms",
      "motion-slow": "320ms"
    },
    "use": "Enter with ease-enter. Leave with ease-exit, faster than the enter. Reorder and drag with ease-move. Every animation stops for prefers-reduced-motion."
  },
  "blocking": [
    {
      "id": "board",
      "use": "Items that move through stages.",
      "parts": [
        "SiteHeader",
        "PageBody",
        "columns"
      ]
    },
    {
      "id": "list-detail",
      "use": "A list of items and the open item.",
      "parts": [
        "SiteHeader",
        "PageBody",
        "list",
        "Sheet"
      ]
    },
    {
      "id": "document",
      "use": "Long text on a page.",
      "parts": [
        "SiteHeader",
        "desk",
        "paper"
      ]
    },
    {
      "id": "form",
      "use": "Settings and new items.",
      "parts": [
        "SiteHeader",
        "PageBody",
        "Field"
      ]
    },
    {
      "id": "agent-panel",
      "use": "A chat with the agent beside the work.",
      "parts": [
        "SiteHeader",
        "PageBody",
        "agent states",
        "approval group"
      ]
    }
  ],
  "cues": [
    {
      "id": "C01",
      "rule": "Use theme tokens for every color. Do not write hex, rgb or oklch values or fixed Tailwind palette classes in components.",
      "check": "script",
      "test": "literal-colors"
    },
    {
      "id": "C02",
      "rule": "Give every token a light value and a dark value.",
      "check": "script",
      "test": "token-pairs"
    },
    {
      "id": "C03",
      "rule": "Text has a contrast of 4.5:1 or more on its surface, in both themes.",
      "check": "script",
      "test": "contrast"
    },
    {
      "id": "C04",
      "rule": "Status marks, icons and lines that carry meaning have a contrast of 3:1 or more.",
      "check": "script",
      "test": "contrast"
    },
    {
      "id": "C05",
      "rule": "Pick a token by its intent. Do not pick a token by its color.",
      "check": "review"
    },
    {
      "id": "C06",
      "rule": "Use one primary action on a screen.",
      "check": "review"
    },
    {
      "id": "C07",
      "rule": "Every signed-in page starts with SiteHeader and puts its content in PageBody.",
      "check": "review"
    },
    {
      "id": "C08",
      "rule": "Build from the shadcn/ui components in @openact/ui. Use Lucide icons through Icon.",
      "check": "review"
    },
    {
      "id": "C09",
      "rule": "Show agent work with the five agent states and the AgentState component. Never show agent work in the brand colors.",
      "check": "script",
      "test": "brand-distance"
    },
    {
      "id": "C10",
      "rule": "An agent change that deletes data or changes people waits for a person. Show Approve and Reject.",
      "check": "test",
      "test": "test/agent.test.ts"
    },
    {
      "id": "C11",
      "rule": "Use the motion tokens. Stop every animation when the person asks for reduced motion.",
      "check": "review"
    },
    {
      "id": "C12",
      "rule": "Write text in ASD-STE100 style: short sentences, active voice, one idea per sentence, American spelling.",
      "check": "review"
    },
    {
      "id": "C13",
      "rule": "Do not use em dashes in text.",
      "check": "script",
      "test": "em-dash"
    },
    {
      "id": "C14",
      "rule": "Start the name of an app token with the app id, such as --app-docs-accent.",
      "check": "script",
      "test": "app-prefix"
    },
    {
      "id": "C15",
      "rule": "Look at every new screen in light and dark, on a phone and on a desktop, before you open a pull request.",
      "check": "review"
    }
  ],
  "method": [
    {
      "step": "01",
      "name": "Script",
      "person": "Write one sentence about who uses the app and what they do.",
      "agent": "Read the Promptbook. Pick the blocking pattern for each screen."
    },
    {
      "step": "02",
      "name": "Cast",
      "person": "Pick one hue for the app accent, if the app needs one.",
      "agent": "Run npm run design -- seed <app-id> <hue>. Paste the tokens into theme.css."
    },
    {
      "step": "03",
      "name": "Block",
      "person": "Approve the list of screens.",
      "agent": "Build each screen from the blocking pattern and @openact/ui components."
    },
    {
      "step": "04",
      "name": "Cue",
      "person": "Say which agent actions need approval.",
      "agent": "Show agent work with AgentState. Write all text in ASD-STE100 style."
    },
    {
      "step": "05",
      "name": "Rehearse",
      "person": "Look at the screens in light and dark, on a phone and a desktop.",
      "agent": "Run npm run design -- check and npm test. Fix every problem."
    },
    {
      "step": "06",
      "name": "Open",
      "person": "Review the pull request and merge it.",
      "agent": "Open a pull request. List the cues that need a review by a person."
    }
  ],
  "contrast": [
    {
      "fg": "foreground",
