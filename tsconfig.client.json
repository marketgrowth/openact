{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": [],
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/client",
    ".openact/client.tsx",
    "packages/ui/src",
    "packages/core/src/shared",
    "apps/*/src/client",
    "apps/*/src/shared",
    "examples/*/src/client"
  ]
}
