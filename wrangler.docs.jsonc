{
  // Demo branch only: the docs site at https://docs.openact.ing, built from this branch.
  // Workers Builds deploys it on each push to the demo branch that changes docs/. See DEMO.md.
  // On main, this file deploys docs.openact.app instead.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openact-docs-demo",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./docs/.vitepress/dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "docs.openact.ing", "custom_domain": true }]
}
