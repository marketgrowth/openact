  "openact": {
    "id": "workspent",
    "name": "WorkSpent",
    "server": "./src/server/index.ts",
    "client": "./src/client/index.tsx",
    "migrations": "./migrations",
    "enabledByDefault": false
  },
  "dependencies": {
    "@openact/core": "0.2.0",
    "@openact/ui": "0.2.0",
    "hono": "^4.13.16",
    "react": "^19.3.1"
  }
}
