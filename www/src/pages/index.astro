---
// The home page at https://openact.ing. Each section is a component in src/components/home/.
// The layout follows the Buio theme: hero, a row of services, features, tabs, numbers, people, pricing, questions and a closing call.
import Site from "../layouts/Site.astro";
import Hero from "../components/home/Hero.astro";
import Stack from "../components/home/Stack.astro";
import Platform from "../components/home/Platform.astro";
import Tour from "../components/home/Tour.astro";
import Code from "../components/home/Code.astro";
import Numbers from "../components/home/Numbers.astro";
import Scale from "../components/home/Scale.astro";
import Audience from "../components/home/Audience.astro";
import Director from "../components/home/Director.astro";
import Plans from "../components/home/Plans.astro";
import Closer from "../components/home/Closer.astro";
---
<Site
  page="home"
  path="/"
  title="OpenAct: open source business apps on Cloudflare"
  description="OpenAct is an open source framework for business apps on Cloudflare. It comes with a Projects app and runs in your own Cloudflare account. Try the free demo."
  ogTitle="Build the apps that run your company"
  ogDescription="OpenAct is an open source framework for business apps on Cloudflare. Try the free demo."
>
  <Hero />
  <Stack />
  <Platform />
  <Tour />
  <Code />
  <Numbers />
  <Scale />
  <Audience />
  <Director />
  <Plans />
  <Closer />
</Site>
