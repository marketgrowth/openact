---
// The Producer page at https://openact.ing/producer. The Plans section on the home page links here.
// Producer is Custom Apps as a Service: MarketGrowth runs OpenAct and builds the customer's primary custom app with them.
// "Book a scoping call" links go to #book, the side drawer in components/build/ScopingDrawer.astro. Its script is public/producer.js.
import Site from "../layouts/Site.astro";
import Wrapper from "../components/ui/Wrapper.astro";
import Heading from "../components/ui/Heading.astro";
import Button from "../components/ui/Button.astro";
import Badge from "../components/ui/Badge.astro";
import Icon from "../components/ui/Icon.astro";
import Faq from "../components/ui/Faq.astro";
import PageHero from "../components/build/PageHero.astro";
import Phases from "../components/build/Phases.astro";
import Split from "../components/build/Split.astro";
import Ideas from "../components/build/Ideas.astro";
import Cta from "../components/build/Cta.astro";
import ScopingDrawer from "../components/build/ScopingDrawer.astro";
import { DEMO_URL, DOCS_URL } from "../site";

const rent = [
  "Many vendors and many bills",
  "Your data sits in each vendor's system",
  "You change your workflow to fit the tool",
  "You pay for seats, and the price grows with your team",
  "You cannot change the product"
];
const own = [
  "One app and one budget",
  "Your data sits on your own OpenAct site, apart from every other company",
  "The app fits your workflow, because agents build it from your own work",
  "No seats: invite your whole team",
  "You, or we, can change the app at any time"
];
const budget = [
  { title: "Add up your tool bills", text: "List each tool that you rent for one job." },
  { title: "Pick the job one app can do", text: "Start with the tool that fits you least." },
  { title: "Move that budget", text: "A $4,800 app is $400 a month over one year. Compare that with your bills." }
];
const includes = [
  "We install and manage OpenAct",
  "Agents build your primary custom app with you",
  "Updates, fixes and new features through the year",
  "Everything in Director: Docs, Advisory and more",
  "No seats: invite your whole team"
];
const faqs = [
  { q: "What does it cost?", a: "A custom app is $4,800. Nonprofits get 50% off. The app has no seats, so a bigger team costs nothing extra." },
  { q: "Who owns the app?", a: "You do. The app runs on your OpenAct site, and your data stays in your company." },
  { q: "What is a primary custom app?", a: "It is the one app that does the main work of your business. Examples are client intake, a program tracker or a staffing app." },
  { q: "Can I start free and move up?", a: "Yes. Start with the free core. Move to Director or Producer when you are ready. Your data stays." },
  { q: "Can I try the apps first?", a: `Yes. The <a href="${DEMO_URL}">demo</a> has every app on. It deletes all data every night.` }
];
---
<Site
  path="/producer"
  title="OpenAct Producer: custom apps as a service"
  description="Stop renting tools from many vendors. OpenAct Producer builds one custom app that you own, for $4,800. Agents build it for your workflow. Your data stays in your own secure site."
  ogTitle="OpenAct Producer: we build your custom app with you"
  ogDescription="A done-for-you studio on OpenAct. We run the install and build your primary custom app with you. You own it."
>
  <PageHero
    eyebrow="Producer plan · Custom Apps as a Service"
    title="Build the web application your business needs to operate today."
    muted="We can help."
    lead="Today you rent tools from many vendors. Each vendor holds a piece of your data. With Producer, you move that budget into one app that you own. Agents build it for your workflow. It runs on your own secure Cloudflare account, code, database and AI gateway included."
    note="Custom app: $4,800. Nonprofits get 50% off."
  >
    <Button href="#book" variant="accent" size="sm">Book a scoping call</Button>
    <Button href="#ideas" variant="muted" size="sm">See what you could build</Button>
  </PageHero>

  <section id="own" aria-labelledby="own-title">
    <Wrapper class="py-24">
      <div class="max-w-2xl">
        <Heading id="own-title" muted="Start owning.">Stop renting.</Heading>
        <p class="mt-6 text-base text-muted-foreground">Your tools cost money every month, and each one holds part of your data. Move that budget into one app. The app is yours, and so is the data.</p>
      </div>
      <div class="mt-16 grid grid-cols-1 gap-16 md:grid-cols-2 md:gap-x-12">
        <div>
          <p class="text-xs text-muted-foreground">What you do today</p>
          <h3 class="mt-1 text-xl font-medium tracking-tight text-muted-foreground">Rent from many vendors</h3>
          <ul class="mt-6 border-b border-muted text-sm text-muted-foreground" role="list">
            {rent.map((r) => <li class="flex gap-3 border-t border-muted py-3"><Icon name="x" class="mt-0.5 size-4 shrink-0" />{r}</li>)}
          </ul>
          <p class="mt-4 text-sm text-muted-foreground">Goal: see what the rented tools really cost you.</p>
        </div>
        <div>
          <p class="text-xs text-muted-foreground">What you get with Producer</p>
          <h3 class="mt-1 text-xl font-medium tracking-tight text-foreground">Own one app</h3>
          <ul class="mt-6 border-b border-muted text-sm text-foreground" role="list">
            {own.map((r) => <li class="flex gap-3 border-t border-muted py-3"><Icon name="check" class="mt-0.5 size-4 shrink-0" />{r}</li>)}
          </ul>
          <p class="mt-4 text-sm text-muted-foreground">Goal: one secure app that fits how you work.</p>
        </div>
      </div>
      <ol class="mt-16 grid grid-cols-1 border-t border-muted md:grid-cols-3">
        {budget.map((b, i) => (
          <li class="flex flex-col py-8 md:pr-8">
            <span class="text-2xl font-medium tracking-tight text-foreground md:text-3xl">{String(i + 1).padStart(2, "0")}</span>
            <span class="mt-4 text-base font-medium text-foreground">{b.title}</span>
            <span class="mt-1 text-sm text-muted-foreground">{b.text}</span>
          </li>
        ))}
      </ol>
    </Wrapper>
  </section>

  <Phases
    id="how"
    title="Three phases."
    muted="One working app."
    lead="Agents write the code, so the app is made for your workflow. They build inside OpenAct's security rules. Sign-in, companies, roles and email are ready on day one. So our time goes into the part that is yours."
    steps={[
      { tag: "Phase 1 · Scope", title: "Map the work.", text: "We sit with your team. Together we map the problem, the tools you use now and the data you keep.", outcome: "an app brief and a plan that your team agrees on." },
      { tag: "Phase 2 · Build", title: "Agents build it on your data.", text: "Agents build a working version of the app on your OpenAct site, with your own data. Access follows each person's role. Risky steps wait for approval. You steer each step.", outcome: "a working app that you can click, not slides." },
      { tag: "Phase 3 · Run", title: "Run it and grow it.", text: "We manage the install, the updates and the fixes. As your business changes, we add to the app.", outcome: "an app in production that your team uses every day." }
    ]}
  />

  <Split
    id="secure"
    title="Secure by design."
    muted="Your app, your data, your infrastructure."
    paragraphs={[
      "You bring the problem and the data. Our agents build the app, and our team checks it. You can watch, ask questions and learn at each step.",
      "At the end, you understand the app. Your team can change it, or we keep it running for you."
    ]}
    points={[
      { title: "You own the app", text: "It is your code on your OpenAct site. It is not rented software." },
      { title: "Your data stays yours", text: "Each company's data is kept apart. Agents never do more than a person's role allows." },
      { title: "Agents that wait for a person", text: "Deletes and other risky steps wait for someone on your team to approve them." },
      { title: "Bring your own AI", text: "Use the default model, or your own model and key." }
    ]}
  />

  <Ideas mode="studio" />

  <section id="plan" aria-labelledby="plan-title">
    <Wrapper class="py-24">
      <div class="max-w-2xl">
        <Heading id="plan-title" muted="$4,800 per custom app.">What Producer includes.</Heading>
        <p class="mt-6 text-base text-muted-foreground">Compare that with what you pay each year for the tools that it replaces. Nonprofits get 50% off.</p>
      </div>
      <div class="mt-16 grid grid-cols-1 gap-y-12 lg:grid-cols-3">
        <div class="flex flex-col lg:pr-8">
          <h3 class="flex items-center gap-4 text-base text-foreground">Producer <Badge>Done for you</Badge></h3>
          <p class="mt-12 text-2xl font-medium tracking-tight text-foreground md:text-3xl lg:text-4xl">$4,800<span class="text-sm font-normal tracking-normal text-muted-foreground"> · per custom app</span></p>
          <p class="mt-3 text-sm text-foreground">Custom Apps as a Service.</p>
          <Button href="#book" variant="default" size="base" class="mt-8 w-full">Book a scoping call</Button>
          <Button href={`${DOCS_URL}/plans`} variant="muted" size="base" class="mt-2 w-full">Read about the plans</Button>
        </div>
        <ul role="list" class="flex flex-col border-b border-muted text-base text-foreground lg:col-span-2">
          {includes.map((item) => <li class="flex gap-4 border-t border-muted py-5"><Icon name="check" class="mt-1 size-4 shrink-0" />{item}</li>)}
        </ul>
      </div>
    </Wrapper>
  </section>

  <Faq id="questions" title="Questions, answered." intro="About Producer and the app that we build with you." items={faqs} />

  <Cta
    id="closer"
    title="Your app is next."
    text="Do not rent a piece of ten tools. Tell us about the work your business repeats. We build one app that fits it, and you own it."
    steps={["Book a scoping call.", "We map the work and write the app brief.", "We build the app with you on OpenAct."]}
  >
    <Button href="#book" variant="accent" size="sm">Book a scoping call</Button>
    <Button href="/build" variant="muted" size="sm">Build it yourself instead</Button>
  </Cta>

  <ScopingDrawer />
  <script is:inline slot="end" src="/producer.js"></script>
</Site>
