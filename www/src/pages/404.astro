---
// The page that the Worker shows for an address that does not exist. From the Buio theme's 404 page.
import Site from "../layouts/Site.astro";
import Wrapper from "../components/ui/Wrapper.astro";
import Button from "../components/ui/Button.astro";
import DitherText from "../components/art/DitherText.astro";
import { DEMO_URL } from "../site";
---
<Site title="Page not found: OpenAct" description="This page does not exist." path="/404" noindex>
  <Wrapper class="flex min-h-svh flex-col items-center justify-center py-24 text-center">
    <div class="aspect-2/1 w-full max-w-4xl">
      <DitherText text="404" />
    </div>
    <h1 class="mt-12 text-3xl font-medium tracking-tight text-foreground md:text-4xl">
      <span class="sr-only">Page not found.</span>
      This scene is not in the script.
    </h1>
    <p class="mt-4 max-w-md text-base text-muted-foreground">We cannot find this page. It moved, or it never existed.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-2">
      <Button href="/" variant="accent" size="sm">Go to the home page</Button>
      <Button href={DEMO_URL} variant="muted" size="sm">Open the demo</Button>
    </div>
  </Wrapper>
</Site>
