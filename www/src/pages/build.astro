---
// The open source build page at https://openact.ing/build: build your own custom apps on the free OpenAct core.
// Its Producer twin is producer.astro. Both share the "What you could build" section (components/build/Ideas.astro).
import { Code } from "astro:components";
import Site from "../layouts/Site.astro";
import Wrapper from "../components/ui/Wrapper.astro";
import Heading from "../components/ui/Heading.astro";
import Button from "../components/ui/Button.astro";
import Badge from "../components/ui/Badge.astro";
import Window from "../components/ui/Window.astro";
import PageHero from "../components/build/PageHero.astro";
import Phases from "../components/build/Phases.astro";
import Split from "../components/build/Split.astro";
import Ideas from "../components/build/Ideas.astro";
import Cta from "../components/build/Cta.astro";
import { DEMO_URL, DEPLOY_URL, DOCS_URL } from "../site";

const session = `> Build a client intake app. A lead fills in
  a form. The agent drafts a scope and a price.
  A person approves it before it goes out.

  reading AGENTS.md · docs/apps.md
  writing apps/intake · tests pass

$ npm run deploy
  migrations applied · worker live`;
---
<Site
  path="/build"
  title="Build your own apps on OpenAct"
  description="Build custom agentic apps for your business on the free, open source OpenAct core. A coding agent builds the app. You own the code and the data."
  ogTitle="Build your first app on OpenAct"
  ogDescription="Describe the app. Your coding agent builds it on the free OpenAct core. You own the code and the data."
>
  <PageHero
    eyebrow="Open source · Build it yourself"
    title="Build the app"
    muted="your business needs."
    lead="Describe the app in plain words. A coding agent such as Claude Code or Codex builds it on the OpenAct core. Sign-in, companies, roles, email and agents are ready. You own the code and the data."
    note="Free under the Apache License 2.0. Runs in your own Cloudflare account."
  >
    <Button href={DEPLOY_URL} variant="accent" size="sm">Deploy to Cloudflare</Button>
    <Button href={`${DOCS_URL}/apps`} variant="muted" size="sm">Read the app guide</Button>
  </PageHero>

  <section aria-labelledby="session-title">
    <Wrapper class="grid grid-cols-1 gap-y-12 py-24 lg:grid-cols-2">
      <div class="lg:pr-12">
        <Heading id="session-title" muted="Your agent does the rest.">Describe the app.</Heading>
        <p class="mt-6 text-base text-muted-foreground">Tell Claude Code or Codex what the app does, in plain words. The agent reads the rules in the repository, builds the app in its own folder and runs the tests. Then you deploy it.</p>
        <div class="mt-8 flex flex-wrap gap-2">
          <Badge variant="outline">Intake · on</Badge>
          <Badge variant="outline">Projects · on</Badge>
          <Badge variant="outline">your account</Badge>
        </div>
      </div>
      <Window title="~/openact">
        <Code class="border-0 p-6 text-sm sm:p-10" code={session} lang="text" theme="css-variables" />
      </Window>
    </Wrapper>
  </section>

  <Phases
    id="how"
    title="From an idea"
    muted="to a live app."
    lead="You do not start from zero. The core does the hard parts. Your app adds only its own features."
    steps={[
      { tag: "Step 1 · Deploy", title: "Put OpenAct on your account.", text: "Deploy the free core to your own Cloudflare account with one click. Projects comes with it.", outcome: "your own OpenAct site, with sign-in and companies ready." },
      { tag: "Step 2 · Describe", title: "Tell your agent what to build.", text: "Describe the app to Claude Code or Codex. The agent follows the rules in AGENTS.md, the Promptbook and the shared components.", outcome: "a working app in its own folder, with tests." },
      { tag: "Step 3 · Ship", title: "Deploy and use it.", text: "Run one deploy command. The app shows in the app rail for each company that turns it on.", outcome: "a live app that your team uses, on your account." }
    ]}
  />

  <Split
    id="core"
    title="Why build on OpenAct."
    muted="The stage is already set."
    paragraphs={[
      "A coding agent can write an app fast. The hard part is everything around it: sign-in, access, data that stays apart and agents with limits.",
      "OpenAct gives your agent all of that, plus clear rules to follow."
    ]}
    points={[
      { title: "Ready on day one", text: "Sign-in, companies, roles, email, files and the app shell." },
      { title: "Rules for coding agents", text: "AGENTS.md, the app guide and the Promptbook tell the agent how to build." },
      { title: "Agents with limits", text: "An app agent never does more than the person's role allows. Risky steps wait for approval." },
      { title: "Your account, your data", text: "It runs on Cloudflare Workers, D1 and R2 in your own account." }
    ]}
  />

  <Ideas mode="diy" />

  <section aria-labelledby="cross-title">
    <Wrapper class="py-12">
      <div class="flex flex-wrap items-center justify-between gap-6 border-y border-muted py-10">
        <div>
          <p class="text-xs text-muted-foreground">Producer plan</p>
          <h2 id="cross-title" class="mt-1 text-2xl font-medium tracking-tight text-foreground">Want us to build it with you?</h2>
          <p class="mt-2 text-sm text-muted-foreground">Producer is our done-for-you studio. We run OpenAct and build your primary custom app with you.</p>
        </div>
        <Button href="/producer" variant="default" size="sm">See Producer</Button>
      </div>
    </Wrapper>
  </section>

  <Cta
    id="closer"
    title="Take the stage."
    text="Custom software is not only for engineers now. Deploy the free core, and build your first app this week."
    steps={["Deploy OpenAct to Cloudflare.", "Describe your app to a coding agent.", "Deploy it and invite your team."]}
  >
    <Button href={DEPLOY_URL} variant="accent" size="sm">Deploy to Cloudflare</Button>
    <Button href={DEMO_URL} variant="muted" size="sm">Try the demo first</Button>
  </Cta>
</Site>
