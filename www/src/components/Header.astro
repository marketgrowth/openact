---
import Logo from "./Logo.astro";
import { DEMO_URL, DOCS_URL, GITHUB_URL } from "../site";

interface Props {
  /** The page that shows the header. "home" links to sections on the same page. */
  page: "home" | "contribute" | "other";
}
const { page } = Astro.props;
const home = page === "home" ? "" : "/";
const current = (name: Props["page"]) => (page === name ? "page" : undefined);
---
<header class="top">
  <div class="wrap">
    <a class="brand" href="/" aria-label="OpenAct home, beta">
      <Logo />
      OpenAct
      <span class="beta" title="OpenAct is in beta. Expect bugs.">BETA</span>
    </a>
    <nav class="nav" aria-label="Main">
      <a class="pill" href={`${home}#features`}>Features</a>
      <a class="pill" href={`${home}#plans`}>Plans</a>
      <a class="pill" href="/design">Design</a>
      <a class="pill" href={DOCS_URL}>Docs</a>
      <a class="pill" href={GITHUB_URL}>GitHub</a>
      <a class="pill" href="/contribute" aria-current={current("contribute")}>Contribute</a>
      <a class="btn btn-accent btn-sm" href={DEMO_URL}>Try the demo</a>
      <!-- The menu on small screens. It is a details element, because these pages run no script. -->
      <details class="menu">
        <summary aria-label="Menu"><span class="menu-icon" aria-hidden="true"><i></i><i></i><i></i></span></summary>
        <div class="menu-panel">
          <a href={`${home}#features`}>Features</a>
          <a href={`${home}#plans`}>Plans</a>
          <a href="/build">Build your own apps</a>
          <a href="/producer">Producer</a>
          <a href="/design">Design</a>
          <a href={DOCS_URL}>Docs</a>
          <a href={GITHUB_URL}>GitHub</a>
          <a href="/contribute" aria-current={current("contribute")}>Contribute</a>
          <a class="btn btn-accent" href={DEMO_URL}>Try the demo</a>
        </div>
      </details>
    </nav>
  </div>
</header>
