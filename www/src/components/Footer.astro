---
// The site footer, from the Buio theme: the wordmark, link columns, and a bottom row with the theme switcher.
import Logo from "./Logo.astro";
import Wrapper from "./ui/Wrapper.astro";
import ThemeSwitcher from "./ui/ThemeSwitcher.astro";
import { DEMO_URL, DEPLOY_URL, DESIGN_URL, DOCS_URL, GITHUB_URL, LICENSE_URL } from "../site";

interface Props {
  page: "home" | "contribute" | "other";
}
const { page } = Astro.props;
const home = page === "home" ? "" : "/";
// The second Developers link points to the docs page that fits the page.
const guide =
  page === "contribute"
    ? { href: `${DOCS_URL}/contribute`, label: "Contributions in the docs" }
    : { href: `${DOCS_URL}/getting-started`, label: "Getting started" };

const columns = [
  {
    title: "Product",
    links: [
      { label: "Demo", href: DEMO_URL },
      { label: "Plans", href: `${home}#plans` },
      { label: "Build your own apps", href: "/build" },
      { label: "Producer", href: "/producer" },
      { label: "Contribute", href: "/contribute", current: page === "contribute" }
    ]
  },
  {
    title: "Developers",
    links: [
      { label: "Docs", href: DOCS_URL },
      guide,
      { label: "Design system", href: DESIGN_URL, newTab: true },
      { label: "GitHub", href: GITHUB_URL }
    ]
  },
  {
    title: "Deploy",
    links: [
      { label: "Deploy to Cloudflare", href: DEPLOY_URL },
      { label: "Apache License 2.0", href: LICENSE_URL }
    ]
  }
];
---
<footer class="relative z-10">
  <Wrapper>
    <div class="border-t border-muted py-12">
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-2">
        <div>
          <a href="/" class="inline-flex items-center gap-3 text-4xl font-medium tracking-tight text-foreground md:text-5xl" aria-label="OpenAct home">
            <Logo class="size-9 md:size-11" />
            OpenAct
          </a>
          <p class="mt-6 max-w-xs text-sm text-muted-foreground">Open source business apps on Cloudflare. OpenAct is made by MarketGrowth.</p>
        </div>
        <div class="grid grid-cols-2 gap-8 sm:grid-cols-3">
          {columns.map((col) => (
            <nav aria-label={col.title}>
              <h3 class="text-base text-foreground">{col.title}</h3>
              <ul class="mt-4 space-y-2">
                {col.links.map((link: { label: string; href: string; current?: boolean; newTab?: boolean }) => (
                  <li>
                    <a
                      href={link.href}
                      aria-current={link.current ? "page" : undefined}
                      target={link.newTab ? "_blank" : undefined}
                      rel={link.newTab ? "noopener" : undefined}
                      class="text-sm text-muted-foreground duration-300 hover:text-foreground"
                    >{link.label}</a>
                  </li>
                ))}
              </ul>
            </nav>
          ))}
        </div>
      </div>
      <div class="mt-24 flex flex-wrap items-center justify-between gap-4 border-t border-muted pt-6">
        <p class="text-sm text-muted-foreground">Copyright 2026 MarketGrowth. OpenAct is open source under the Apache License 2.0.</p>
        <ThemeSwitcher variant="segmented" />
      </div>
    </div>
  </Wrapper>
</footer>
