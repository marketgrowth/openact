---
// The OpenAct mark: a plain O in a rounded square. The ring takes the page background color.
interface Props {
  class?: string;
}
const { class: className = "size-6" } = Astro.props;
---
<svg viewBox="0 0 32 32" aria-hidden="true" class={className}><rect width="32" height="32" rx="8" fill="currentColor" /><circle cx="16" cy="16" r="8" fill="none" stroke-width="4.5" style="stroke: var(--background)" /></svg>
