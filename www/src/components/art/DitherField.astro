---
// From the Buio theme by Lexington Themes. A WebGL dither that draws light dots.
// The .dither class (src/styles/global.css) turns the dots dark on the light theme.
const { class: className = "" } = Astro.props;
---

<canvas style="image-rendering: pixelated" class:list={["dither block size-full", className]} data-dither-field aria-hidden="true"></canvas>

<script>
  const vertex = `
    attribute vec2 position;
    void main() { gl_Position = vec4(position, 0.0, 1.0); }
  `;

  const fragment = `
    precision highp float;
    uniform vec2 resolution;
    uniform float time;
    uniform float dpr;

    float hash(vec2 p) {
      return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
    }
    float noise(vec2 p) {
      vec2 i = floor(p);
      vec2 f = fract(p);
      vec2 u = f * f * (3.0 - 2.0 * f);
      return mix(
        mix(hash(i), hash(i + vec2(1.0, 0.0)), u.x),
        mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), u.x),
        u.y
      );
    }
    float fbm(vec2 p) {
      float v = 0.0;
      float a = 0.5;
      for (int i = 0; i < 4; i++) {
        v += a * noise(p);
        p = p * 2.03 + vec2(4.1, 1.7);
        a *= 0.5;
      }
      return v;
    }
    float bayer2(vec2 a) {
      a = floor(a);
      return fract(a.x / 2.0 + a.y * a.y * 0.75);
    }
    float bayer4(vec2 a) {
      return bayer2(0.5 * a) * 0.25 + bayer2(a);
    }
    float bayer8(vec2 a) {
      return bayer4(0.5 * a) * 0.25 + bayer2(a);
    }

    void main() {
      float pixel = 2.0 * dpr;
      vec2 cell = floor(gl_FragCoord.xy / pixel);
      vec2 uv = cell * pixel / resolution;
      float aspect = resolution.x / resolution.y;
      float t = time * 0.12;

      float ridge = 0.3 + (fbm(vec2(uv.x * aspect * 1.2 + t, t * 0.5)) - 0.5) * 0.3;
      float below = ridge - uv.y;
      float land = smoothstep(0.0, 0.22, below);
      float swell = fbm(vec2(uv.x * aspect * 3.0 - t * 1.5, uv.y * 14.0 + t));
      float waves = 0.5 + 0.5 * sin(uv.y * 90.0 + swell * 9.0 - time * 0.8);
      float spray = smoothstep(0.05, 0.0, abs(below)) * smoothstep(0.45, 0.7, fbm(cell * 0.3 + t * 4.0));

      float level = land * mix(0.45, 1.0, waves) + spray * 0.5;

      vec2 c = (uv - vec2(0.5, 0.62)) * vec2(1.1, 1.8);
      level *= smoothstep(0.3, 0.55, length(c));

      float on = step(bayer8(cell) + 0.02, level);
      float alpha = on * 0.55;
      gl_FragColor = vec4(vec3(alpha), alpha);
    }
  `;

  function start(canvas: HTMLCanvasElement) {
    const gl = canvas.getContext("webgl", { premultipliedAlpha: true, antialias: false });
    if (!gl) return;

    const compile = (type: number, source: string) => {
      const shader = gl.createShader(type)!;
      gl.shaderSource(shader, source);
      gl.compileShader(shader);
      return shader;
    };
    const program = gl.createProgram()!;
    gl.attachShader(program, compile(gl.VERTEX_SHADER, vertex));
    gl.attachShader(program, compile(gl.FRAGMENT_SHADER, fragment));
    gl.linkProgram(program);
    if (!gl.getProgramParameter(program, gl.LINK_STATUS)) return;
    gl.useProgram(program);

    gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    const position = gl.getAttribLocation(program, "position");
    gl.enableVertexAttribArray(position);
    gl.vertexAttribPointer(position, 2, gl.FLOAT, false, 0, 0);

    const resolution = gl.getUniformLocation(program, "resolution");
    const time = gl.getUniformLocation(program, "time");
    const dprLocation = gl.getUniformLocation(program, "dpr");

    const resize = () => {
      const dpr = 0.5;
      canvas.width = Math.max(1, Math.round(canvas.clientWidth * dpr));
      canvas.height = Math.max(1, Math.round(canvas.clientHeight * dpr));
      gl.viewport(0, 0, canvas.width, canvas.height);
      gl.uniform2f(resolution, canvas.width, canvas.height);
      gl.uniform1f(dprLocation, dpr);
    };
    resize();
    new ResizeObserver(resize).observe(canvas);

    const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let visible = true;
    let frame = 0;
    let last = -Infinity;
    const render = (now: number) => {
      if (!still && now - last < 33) {
        frame = requestAnimationFrame(render);
        return;
      }
      last = now;
      gl.uniform1f(time, still ? 4.0 : now / 1000);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
      if (!still && visible) frame = requestAnimationFrame(render);
    };
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      cancelAnimationFrame(frame);
      if (visible) frame = requestAnimationFrame(render);
    }).observe(canvas);
    requestAnimationFrame(render);
  }

  const boot = () =>
    document.querySelectorAll<HTMLCanvasElement>("[data-dither-field]").forEach(start);
  const idle = () =>
    "requestIdleCallback" in window ? requestIdleCallback(boot, { timeout: 2000 }) : setTimeout(boot, 200);
  if (document.readyState === "complete") idle();
  else window.addEventListener("load", idle, { once: true });
</script>
