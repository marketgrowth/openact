---
// Shape4: a static line drawing for the feature cards.
// Props: - class: A string of additional classes to style the component.
// - ...rest: Any other valid attributes for an div element (e.g., id, style, role, aria-label, etc.).
// Example Usage: <Shape4 class="my-custom-class" />
const { class: className = "", ...rest } = Astro.props;
---

<div class={className} {...rest}>
  <svg
    viewBox="0 0 400 400"
    fill="none"
    stroke="currentColor"
    stroke-width="1"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <polygon points="200.0,105.0 282.3,152.5 282.3,247.5 200.0,295.0 117.7,247.5 117.7,152.5"></polygon>
  </svg>
</div>
