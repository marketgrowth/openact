---
// The Director apps: Docs and Advisory. The pictures come from scripts/make-art.py.
import Wrapper from "../ui/Wrapper.astro";
import Heading from "../ui/Heading.astro";
import Badge from "../ui/Badge.astro";
const apps = [
  {
    art: "sheets",
    name: "Docs",
    title: "Write together, on real pages.",
    text: "Docs on Letter, A4 or Legal pages. Edit live with a cursor for each person. Add comments and @mentions. Share with a link or print to PDF."
  },
  {
    art: "people",
    name: "Advisory",
    title: "A marketplace of your advisors.",
    text: "Members book a consult or pay for an offer in advance. Clients pay through Stripe Connect, and a paid engagement opens a private project."
  }
];
---
<section id="director" aria-labelledby="director-title">
  <Wrapper class="py-24">
    <div class="max-w-2xl">
      <Heading id="director-title" muted="Two more apps for growing teams.">The Director plan.</Heading>
      <p class="mt-6 text-base text-muted-foreground">Docs and Advisory need the OpenAct Director plan. You can try both for free on the demo.</p>
    </div>
    <div class="mt-16 grid grid-cols-1 gap-16 md:grid-cols-2 md:gap-x-12">
      {apps.map((a) => (
        <article>
          <div class="flex aspect-video items-center justify-center overflow-hidden bg-gradient-down">
            <img class="dither w-1/2 [image-rendering:pixelated]" src={`/images/art/${a.art}.png`} width="360" height="270" alt="" loading="lazy" />
          </div>
          <div class="mt-6 flex items-center gap-3">
            <h3 class="text-base font-medium text-foreground">{a.name}</h3>
            <Badge variant="outline">Director</Badge>
          </div>
          <p class="mt-1 text-sm text-muted-foreground">{a.title}</p>
          <p class="mt-4 max-w-lg text-sm text-foreground">{a.text}</p>
        </article>
      ))}
    </div>
  </Wrapper>
</section>
