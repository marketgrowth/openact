---
// A tour of the demo: tabs on the left, a screenshot on the right. From the Buio theme's developer tabs.
// Each screenshot has a light and a dark file. The page shows the one for the current theme.
import Wrapper from "../ui/Wrapper.astro";
import Heading from "../ui/Heading.astro";
const tabs = [
  {
    title: "Plan on a board",
    text: "Make your own columns. Drag cards between them. Phases, priorities, owners and dates.",
    img: "board",
    height: 900,
    alt: "The OpenAct Projects board for a Spring season launch project. Tasks sit in Backlog, To do, In progress and Review columns, with phases, priorities and dates."
  },
  {
    title: "Schedule a timeline",
    text: "See every task as a bar on a Gantt timeline. Drag a bar to move a task. A red line shows today.",
    img: "timeline",
    height: 900,
    alt: "The OpenAct timeline. Tasks group by phase: Discovery, Design, Build and Launch. Colored bars show each task's dates, and a red line marks today."
  },
  {
    title: "See the month",
    text: "Cards show the day a task starts. Pills show its deadline. Drag either one to change it.",
    img: "calendar",
    height: 900,
    alt: "The OpenAct calendar for November. Cards show the days that tasks start. Pills show deadlines."
  },
  {
    title: "Add apps",
    text: "A company owner turns apps on or off. Add an app with one command, or build your own with Claude Code or Codex.",
    img: "apps",
    height: 815,
    alt: "The OpenAct Apps page. Projects, Docs and Advisory are on in the company. Docs and Advisory show a Director badge. Below, the directory lists more apps under review."
  },
  {
    title: "Make it yours",
    text: "Each deploy carries your brand: your app name and logo, your sign-in page, and your terms and privacy links.",
    img: "signin",
    height: 900,
    alt: "The OpenAct sign-in page. A quote sits on a dark panel beside an email sign-in form."
  }
];
---
<section id="tour" aria-labelledby="tour-title">
  <Wrapper class="py-24">
    <div class="grid grid-cols-1 gap-y-12 lg:grid-cols-3" data-tabs>
      <div class="lg:pr-12">
        <Heading id="tour-title" muted="Click through the demo.">Inside OpenAct.</Heading>
        <div class="mt-12 flex flex-col gap-8" role="tablist" aria-label="Parts of the demo">
          {tabs.map((tab, i) => (
            <button
              type="button"
              role="tab"
              id={`tour-tab-${i}`}
              aria-controls={`tour-panel-${i}`}
              aria-selected={i === 0 ? "true" : "false"}
              data-tab={i}
              class="w-full cursor-pointer text-left opacity-50 transition-opacity duration-300 hover:opacity-100 aria-selected:opacity-100"
            >
              <span class="block text-base font-medium text-foreground">{tab.title}</span>
              <span class="mt-2 hidden text-sm text-muted-foreground md:block">{tab.text}</span>
            </button>
          ))}
        </div>
      </div>
      <div class="lg:col-span-2">
        {tabs.map((tab, i) => (
          <div role="tabpanel" id={`tour-panel-${i}`} aria-labelledby={`tour-tab-${i}`} data-panel={i} class:list={[i !== 0 && "hidden"]}>
            <div class="border border-b-0 border-muted bg-background px-4 py-2">
              <div class="flex items-center gap-1" aria-hidden="true">
                <div class="size-2 rounded-full outline outline-secondary-highlight"></div>
                <div class="size-2 rounded-full outline outline-secondary"></div>
                <div class="size-2 rounded-full outline outline-secondary"></div>
              </div>
            </div>
            <div class="border border-muted">
              <img class="only-light block h-auto w-full" src={`/images/${tab.img}-light.webp`} width="1440" height={tab.height} alt={tab.alt} loading={i === 0 ? "eager" : "lazy"} />
              <img class="only-dark h-auto w-full" src={`/images/${tab.img}-dark.webp`} width="1440" height={tab.height} alt={tab.alt} loading={i === 0 ? "eager" : "lazy"} />
            </div>
          </div>
        ))}
      </div>
    </div>
  </Wrapper>
</section>
<script>
  import "../../scripts/tabs.ts";
</script>
