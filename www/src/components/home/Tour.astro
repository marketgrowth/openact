<section class="card tour" aria-label="A tour of OpenAct">
  <input type="radio" name="tour" id="t1" checked />
  <input type="radio" name="tour" id="t2" />
  <input type="radio" name="tour" id="t3" />
  <input type="radio" name="tour" id="t4" />
  <input type="radio" name="tour" id="t5" />
  <div class="tour-head">
    <p class="eyebrow">Inside the demo</p>
    <div class="tabs">
      <label for="t1">Board</label>
      <label for="t2">Timeline</label>
      <label for="t3">Calendar</label>
      <label for="t4">Apps</label>
      <label for="t5">Sign-in</label>
    </div>
  </div>
  <div class="panel p1">
    <div class="copy">
      <p class="eyebrow">Projects</p>
      <h3>Plan on a board.</h3>
      <p>Make your own columns. Drag cards between them.</p>
      <ul><li>Every open page shows changes at once.</li><li>Phases, priorities, owners and dates.</li><li>Secret projects for invited people.</li></ul>
    </div>
    <div class="shot"><picture><source srcset="/images/board-dark.webp" media="(prefers-color-scheme: dark)" /><img src="/images/board-light.webp" width="1440" height="900" alt="The OpenAct Projects board for a Spring season launch project. Tasks sit in Backlog, To do, In progress and Review columns, with phases, priorities and dates." /></picture></div>
  </div>
  <div class="panel p2">
    <div class="copy">
      <p class="eyebrow">Projects</p>
      <h3>Schedule a timeline.</h3>
      <p>See every task as a bar on a Gantt timeline.</p>
      <ul><li>Drag a bar to move a task.</li><li>Tasks group by phase.</li><li>A red line shows today.</li></ul>
    </div>
    <div class="shot"><picture><source srcset="/images/timeline-dark.webp" media="(prefers-color-scheme: dark)" /><img src="/images/timeline-light.webp" width="1440" height="900" loading="lazy" alt="The OpenAct timeline. Tasks group by phase: Discovery, Design, Build and Launch. Colored bars show each task's dates, and a red line marks today." /></picture></div>
  </div>
  <div class="panel p3">
    <div class="copy">
      <p class="eyebrow">Projects</p>
      <h3>See the month.</h3>
      <p>Cards show the day a task starts. Pills show its deadline.</p>
      <ul><li>Drag a card to move the task.</li><li>Drag a pill to change the deadline.</li></ul>
    </div>
    <div class="shot"><picture><source srcset="/images/calendar-dark.webp" media="(prefers-color-scheme: dark)" /><img src="/images/calendar-light.webp" width="1440" height="900" loading="lazy" alt="The OpenAct calendar for November. Cards show the days that tasks start. Pills show deadlines." /></picture></div>
  </div>
  <div class="panel p4">
    <div class="copy">
      <p class="eyebrow">App directory</p>
      <h3>Add apps.</h3>
      <p>A company owner turns apps on or off.</p>
      <ul><li>Add an app with one command.</li><li>Build your own with Claude Code or Codex.</li></ul>
    </div>
    <div class="shot"><picture><source srcset="/images/apps-dark.webp" media="(prefers-color-scheme: dark)" /><img src="/images/apps-light.webp" width="1440" height="815" loading="lazy" alt="The OpenAct Apps page. Projects, Docs and Advisory are on in the company. Docs and Advisory show a Director badge. Below, the directory lists more apps under review." /></picture></div>
  </div>
  <div class="panel p5">
    <div class="copy">
      <p class="eyebrow">Site settings</p>
      <h3>Make it yours.</h3>
      <p>Each deploy carries your brand.</p>
      <ul><li>Your app name and logo.</li><li>Your sign-in heading and background.</li><li>Your Terms of Use and Privacy Policy links.</li></ul>
    </div>
    <div class="shot"><picture><source srcset="/images/signin-dark.webp" media="(prefers-color-scheme: dark)" /><img src="/images/signin-light.webp" width="1440" height="900" loading="lazy" alt="The OpenAct sign-in page. A quote sits on a dark panel beside an email sign-in form." /></picture></div>
  </div>
</section>
