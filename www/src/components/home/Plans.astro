---
// The plans. From the Buio theme's pricing: three columns, no cards. The questions follow in an FAQ.
import Wrapper from "../ui/Wrapper.astro";
import Heading from "../ui/Heading.astro";
import Button from "../ui/Button.astro";
import Badge from "../ui/Badge.astro";
import Icon from "../ui/Icon.astro";
import Faq from "../ui/Faq.astro";
import { DEMO_URL } from "../../site";
const plans = [
  {
    title: "Free",
    tag: "",
    price: "$0",
    period: "",
    description: "Open source under the Apache License 2.0. For everyone.",
    benefits: ["The core, the UI and Projects", "Agent with approvals", "Bring your own AI", "Many companies, no seat limits", "Your own Cloudflare account"],
    cta: { label: "Build your own apps", href: "/build", variant: "muted" as const },
    popular: false
  },
  {
    title: "Director",
    tag: "Free on the demo",
    price: "Yearly",
    period: " · one price per company",
    description: "For growing organizations that build their own apps.",
    benefits: ["Everything in Free", "Docs: live editing and comments", "Advisory: a marketplace with Stripe", "New paid apps as they join", "Stripe on a hosted site, or a license key", "50% off for nonprofits"],
    cta: { label: "Try Director on the demo", href: DEMO_URL, variant: "default" as const },
    popular: true
  },
  {
    title: "Producer",
    tag: "",
    price: "$4,800",
    period: " · per custom app",
    description: "Custom Apps as a Service. We do the work with you.",
    benefits: ["Everything in Director", "Done for you: we install and manage OpenAct", "We work with you to build your primary custom app", "50% off for nonprofits"],
    cta: { label: "See Producer", href: "/producer", variant: "muted" as const },
    popular: false
  }
];
const faqs = [
  { q: "How is the price set?", a: "Each paid plan has one price per company, not per person. Choose Director to build your own apps. Choose Producer when you want us to do the work. Nonprofits pay half." },
  { q: "How do I pay?", a: "On a hosted OpenAct site, a company owner pays on the Plan page with Stripe. On your own deploy, MarketGrowth gives you a license key." },
  { q: "What happens without a plan?", a: "On a hosted site, the paid apps lock, but their data stays. They come back with all their data when the plan comes back. On your own deploy, the app versions you have keep working when your license ends. You renew to get updates and new apps." },
  { q: "Can I try the paid apps first?", a: "Yes. The demo has Docs and Advisory on for every company. The demo deletes all data every night." }
];
---
<section id="plans" aria-labelledby="plans-title">
  <Wrapper class="py-24">
    <div class="max-w-2xl">
      <Heading id="plans-title" muted="No seats.">One price per company.</Heading>
      <p class="mt-6 text-base text-muted-foreground">Start free with the open source core. The number of people does not change the price. Nonprofits get 50% off every paid plan.</p>
    </div>
    <div class="mt-16 grid grid-cols-1 gap-y-24 md:grid-cols-2 lg:grid-cols-3">
      {plans.map((plan) => (
        <div class="flex flex-col md:pr-8">
          <h3 class="flex items-center gap-4 text-base text-foreground">
            {plan.title}
            {plan.tag && <Badge>{plan.tag}</Badge>}
          </h3>
          <p class="mt-16 text-2xl font-medium tracking-tight text-foreground md:text-3xl lg:text-4xl">
            {plan.price}<span class="font-sans text-sm font-normal tracking-normal text-muted-foreground">{plan.period}</span>
          </p>
          <p class="mt-3 text-sm text-foreground">{plan.description}</p>
          <Button href={plan.cta.href} variant={plan.cta.variant} size="base" class="mt-8 w-full">{plan.cta.label}</Button>
          <ul role="list" class:list={["mt-10 flex flex-col gap-4 text-sm", plan.popular ? "text-foreground" : "text-muted-foreground"]}>
            {plan.benefits.map((b) => (
              <li class="flex gap-4"><Icon name="check" class="mt-0.5 size-4 shrink-0" />{b}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </Wrapper>
</section>
<Faq id="plan-questions" title="Questions, answered." intro="About the plans and how you pay." items={faqs} />
