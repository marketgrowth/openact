---
import { DEMO_URL } from "../../site";
---
<section class="card closer" id="demo" aria-labelledby="demo-title">
  <div class="closer-grid">
    <div>
      <p class="eyebrow">The demo stage</p>
      <h2 id="demo-title">Take the stage.</h2>
      <p>Every app is on in the demo, Docs and Advisory too. Make a company, start a project and invite a friend.</p>
      <p>The demo deletes all data every night at about 2 AM Pacific time. Do not put private data in it.</p>
    </div>
    <div class="start">
      <div class="key"><b>01</b>Open a.openact.ing.</div>
      <div class="key"><b>02</b>Type your email. We send you a sign-in code.</div>
      <div class="key"><b>03</b>Make a company, then open an app.</div>
      <a class="btn btn-accent" href={DEMO_URL}>Open the demo</a>
    </div>
  </div>
</section>
