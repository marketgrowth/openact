---
// The home page hero: the dithered globe behind a centered headline. From the Buio theme's hero.
import Button from "../ui/Button.astro";
import Wrapper from "../ui/Wrapper.astro";
import DitherOrb from "../art/DitherOrb.astro";
import { DEMO_URL, DEPLOY_URL } from "../../site";
---
<section class="relative overflow-hidden">
  <!-- The globe sits in a band of fixed height at the bottom, so long copy never runs into it. -->
  <div class="absolute inset-x-0 bottom-0 h-[34rem] mask-radial-from-50% mask-radial-to-90% sm:h-[40rem] lg:h-[46rem]">
    <DitherOrb />
  </div>
  <Wrapper class="relative flex flex-col pt-36 pb-56 sm:pt-40 sm:pb-64 lg:min-h-svh lg:pb-72">
    <div class="mx-auto flex max-w-4xl flex-col items-center text-center">
      <p class="text-xs tracking-wide text-muted-foreground">Open source · Runs on Cloudflare</p>
      <h1 class="mt-4 text-4xl font-medium tracking-tight text-foreground sm:text-5xl lg:text-6xl">
        <span class="block">All the world's a stage.</span>
        <span class="block text-muted-foreground">Build the apps that run it.</span>
      </h1>
      <p class="mt-6 max-w-xl text-base text-muted-foreground">
        OpenAct is an open source framework for business apps. It comes with Projects. Build more apps with your AI coding agent. You own the code and the data.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-2">
        <Button href={DEMO_URL} variant="accent" size="sm">Try the demo</Button>
        <Button href={DEPLOY_URL} variant="muted" size="sm">Deploy to Cloudflare</Button>
      </div>
      <p class="mt-4 text-xs text-muted-foreground">Apache License 2.0. The demo is free. You do not need a password.</p>
    </div>
  </Wrapper>
</section>
