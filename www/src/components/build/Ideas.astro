---
// "What you could build": one worked example, a list of apps with a dropdown for each, and fields.
// Used by /build (you build it) and /producer (we build it with you).
// Keep the examples generic. Do not name official OpenAct apps or real customers here.
// The dropdowns use <details>, so they work without JavaScript. The look follows the Buio theme.
import Wrapper from "../ui/Wrapper.astro";
import Heading from "../ui/Heading.astro";
import Window from "../ui/Window.astro";
import Icon from "../ui/Icon.astro";
import Badge from "../ui/Badge.astro";
interface Props {
  /** "diy" for the open source page, "studio" for the Producer page. */
  mode: "diy" | "studio";
}
const { mode } = Astro.props;
const studio = mode === "studio";

const intro = studio
  ? "Pick one tool that you rent today and that does not fit your work. We build the app that replaces it. You own it, and the data stays in your account."
  : "Pick one tool that you rent today and that does not fit your work. Describe the app to your coding agent, and build it on the OpenAct core. The data stays in your account.";
const listLead = studio ? "We build your first…" : "Build your first…";
const listHint = "Open an item to see what the app can do.";

// The worked example, in the order that it happens.
const steps = [
  {
    title: "A lead fills in one form",
    text: "The form asks for the company, the need and the budget. The answers save in your app, in your own account.",
  },
  {
    title: "The agent drafts a scope and a price",
    text: "It reads the answers and your past quotes. It writes a draft. It does not send anything.",
  },
  {
    title: "A person on your team approves",
    text: "You read the draft. You change it or approve it. The agent waits for you.",
  },
  {
    title: "The client gets the quote",
    text: "After you approve, the quote goes out. The lead moves to your pipeline.",
  },
];

const ideas = [
  {
    name: "Client intake and pricing tool",
    text: "A lead fills in one form. The agent drafts a scope and a price from your past quotes. A person approves it before it goes out.",
  },
  {
    name: "Deal pipeline with follow-up drafts",
    text: "Each deal has a stage and a next step. The agent writes a follow-up for each quiet deal. You approve each message.",
  },
  {
    name: "Proposal and scope of work builder",
    text: "Pick a client and a service. The agent builds the proposal from your own templates and prices. Your team edits the draft.",
  },
  {
    name: "Custom CRM for consultants",
    text: "Keep clients, calls and notes in one place. The agent summarizes each call and lists the next actions. OpenAct has no seats, so your whole team can use it.",
  },
  {
    name: "Team KPI tracker",
    text: "Each person or team has goals and numbers. The agent writes a weekly summary and flags the numbers that fall behind.",
  },
  {
    name: "Freelance invoicing system",
    text: "Log the work for each client. The agent builds the invoice from the log. You send it after you check it.",
  },
  {
    name: "Volunteer sign-up and shifts",
    text: "People pick open shifts. The app tracks hours and sends reminders. The agent fills gaps and drafts thank-you notes.",
  },
  {
    name: "Donor update writer",
    text: "Program data and donor notes live in one app. The agent writes a short update for each donor. A person reads it before it goes out.",
  },
  {
    name: "Program attendance tracker",
    text: "Staff mark who came to each session. The app shows trends by program. The agent flags drops in attendance.",
  },
  {
    name: "Student progress dashboard",
    text: "Lessons, scores and notes build one view for each student. The agent flags students who need help and drafts updates to families.",
  },
  {
    name: "Compliance checklist tracker",
    text: "Each rule becomes a checklist item with an owner and a due date. The agent flags gaps and expired records before an audit.",
  },
  {
    name: "Inventory and reorder planner",
    text: "Track stock and sales. The agent predicts when an item runs out and drafts the purchase order. You approve it.",
  },
  {
    name: "Help desk with agent replies",
    text: "Requests come into one inbox. The agent drafts a reply from your own documents. A person approves any reply that is not routine.",
  },
  {
    name: "Blog-to-social content calendar",
    text: "Put each post on a calendar. The agent writes the social posts for each channel in your voice. You approve them.",
  },
  {
    name: "Member directory and renewals",
    text: "Keep a profile for each member. The app tracks renewal dates. The agent drafts renewal reminders and flags members at risk.",
  },
];

const fields = [
  {
    name: "Consulting and professional services",
    text: "Calls, proposals and scopes of work go into one app. The agent drafts scopes, finds upsell chances and writes follow-ups.",
    result: "A client app built on your own engagements."
  },
  {
    name: "Care and residential facilities",
    text: "Staff schedules, training records and state checklists live in one place. The agent flags gaps before an audit.",
    result: "A compliance and staffing app built on your records."
  },
  {
    name: "Nonprofits and community programs",
    text: "Attendance, volunteer hours and donor notes feed the app. The agent writes program updates for each donor.",
    result: "A program app that reports your impact."
  },
  {
    name: "Education and arts programs",
    text: "Lessons, assessments and family notes build a progress view. The agent flags students who need help and writes updates to parents.",
    result: "A student progress app built from your class data."
  },
  {
    name: "Remote teams and talent networks",
    text: "Profiles, skills and hours sit side by side. The agent matches people to client work and drafts the weekly report.",
    result: "A talent app that knows who can do the work."
  },
  {
    name: "Media and publishing",
    text: "Story ideas, drafts and sources move through one desk. The agent checks each draft against your editorial rules.",
    result: "A newsroom app that follows your standards."
  }
];
---
<section id="ideas" aria-labelledby="ideas-title">
  <Wrapper class="py-24">
    <div class="max-w-2xl">
      <Heading id="ideas-title" muted="Start with one tool that you rent.">What you could build.</Heading>
      <p class="mt-6 text-base text-muted-foreground">{intro}</p>
    </div>

    <article class="mt-16 grid grid-cols-1 gap-12 lg:grid-cols-2" aria-labelledby="example-title">
      <div class="lg:pr-12">
        <p class="text-xs text-muted-foreground">One example, step by step</p>
        <h3 id="example-title" class="mt-2 text-2xl font-medium tracking-tight text-foreground">Client intake and pricing tool</h3>
        <p class="mt-4 text-sm text-muted-foreground"><span class="text-foreground">The problem:</span> A lead asks for a quote. Someone on your team writes the scope and the price by hand. It takes days, and the numbers live in a tool that you rent.</p>
        <p class="mt-3 text-sm text-muted-foreground"><span class="text-foreground">The app:</span> One app, in your account, does the same work in minutes. The agent drafts. Your team decides.</p>
        <ol class="mt-8 border-b border-muted">
          {steps.map((step, i) => (
            <li class="flex gap-4 border-t border-muted py-4">
              <span class="font-mono text-xs leading-6 text-muted-foreground">{String(i + 1).padStart(2, "0")}</span>
              <div>
                <p class="text-sm font-medium text-foreground">{step.title}</p>
                <p class="mt-1 text-sm text-muted-foreground">{step.text}</p>
              </div>
            </li>
          ))}
        </ol>
        {studio && (
          <p class="mt-6 text-sm text-muted-foreground"><span class="text-foreground">Price:</span> a custom app like this one is <span class="text-foreground">$4,800</span>. Nonprofits get 50% off.</p>
        )}
      </div>
      <Window title="Client intake" bodyClass="p-6 sm:p-8">
        <Badge slot="bar" variant="outline" class="ml-auto">your app</Badge>
        <div role="img" aria-label="A sketch of the app. Step 1 shows what the lead entered. Step 2 shows the agent's draft. Step 3 shows the Approve button.">
          <p class="font-mono text-xs text-muted-foreground">01 · What the lead entered</p>
          <dl class="mt-3 border-b border-muted text-sm">
            <div class="flex justify-between gap-4 border-t border-muted py-2.5"><dt class="text-muted-foreground">Company</dt><dd class="text-foreground">Harbor Studio</dd></div>
            <div class="flex justify-between gap-4 border-t border-muted py-2.5"><dt class="text-muted-foreground">Need</dt><dd class="text-foreground">Website refresh</dd></div>
            <div class="flex justify-between gap-4 border-t border-muted py-2.5"><dt class="text-muted-foreground">Budget</dt><dd class="text-foreground">$8k to $12k</dd></div>
          </dl>
          <p class="mt-8 font-mono text-xs text-muted-foreground">02 · What the agent drafted</p>
          <div class="mt-3 border border-muted bg-gradient-down p-4">
            <div class="flex items-center justify-between gap-4 text-xs text-muted-foreground"><span>Draft quote</span><span class="inline-flex items-center gap-1.5"><span class="size-1.5 rounded-full bg-gold"></span>waiting for you</span></div>
            <p class="mt-2 text-xl font-medium tracking-tight text-foreground">3 pages · 4 weeks · $9,800</p>
          </div>
          <p class="mt-8 font-mono text-xs text-muted-foreground">03 · What you do</p>
          <div class="mt-3 flex gap-2">
            <span class="inline-flex h-9 items-center rounded-lg bg-linear-to-t from-background to-muted px-4 text-xs font-medium text-foreground shadow-dimensional">Edit</span>
            <span class="inline-flex h-9 items-center rounded-lg bg-linear-to-t from-accent-deep to-accent px-4 text-xs font-medium text-accent-foreground shadow-dimensional">Approve and send</span>
          </div>
        </div>
      </Window>
    </article>

    <div class="mt-24 grid grid-cols-1 gap-y-12 lg:grid-cols-3">
      <div class="lg:pr-12">
        <h3 class="text-2xl font-medium tracking-tight text-foreground">{listLead}</h3>
        <p class="mt-3 text-sm text-muted-foreground">{listHint}</p>
      </div>
      <div class="grid grid-cols-1 border-b border-muted md:grid-cols-2 md:gap-x-8 lg:col-span-2">
        {ideas.map((idea, i) => (
          <details class="group border-t border-muted py-4">
            <summary class="flex cursor-pointer list-none items-start gap-4 text-base text-foreground select-none [&::-webkit-details-marker]:hidden">
              <span class="font-mono text-xs leading-6 text-muted-foreground">{String(i + 1).padStart(2, "0")}</span>
              <span class="grow">{idea.name}</span>
              <Icon name="plus" class="mt-1 size-4 shrink-0 duration-300 group-open:rotate-45 group-open:text-muted-foreground" />
            </summary>
            <p class="pt-3 pl-9 text-sm text-muted-foreground">{idea.text}</p>
          </details>
        ))}
      </div>
    </div>

    <dl class="mt-24 grid grid-cols-1 gap-y-12 md:grid-cols-2 md:gap-x-8 lg:grid-cols-3 lg:gap-x-12">
      {fields.map((f) => (
        <div class="flex flex-col border-t border-muted pt-6">
          <dt class="text-base font-medium text-foreground">{f.name}</dt>
          <dd class="mt-2 text-sm text-muted-foreground">{f.text}</dd>
          <dd class="mt-4 text-sm text-foreground"><span class="text-muted-foreground">Result:</span> {f.result}</dd>
        </div>
      ))}
    </dl>
  </Wrapper>
</section>
