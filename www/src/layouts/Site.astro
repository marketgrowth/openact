---
// The layout for openact.ing marketing pages: head tags, fonts, the theme, header and footer.
// A new page: make src/pages/<name>.astro and wrap it in <Site>. Style it with Tailwind classes and the tokens in src/styles/global.css.
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { FONTS, OG_IMAGE, OG_IMAGE_ALT, SITE_URL } from "../site";

interface Props {
  /** The browser tab title. */
  title: string;
  /** The search result text. */
  description: string;
  /** The page path, such as "/" or "/contribute". */
  path: string;
  /** The title for link previews. The default is the page title. */
  ogTitle?: string;
  /** The text for link previews. The default is the description. */
  ogDescription?: string;
  /** Which header and footer links point to this page. */
  page?: "home" | "contribute" | "other";
  /** Classes for the main element. */
  mainClass?: string;
  /** Keep the page out of search results. */
  noindex?: boolean;
}
const { title, description, path, ogTitle = title, ogDescription = description, page = "other", mainClass, noindex = false } = Astro.props;
const url = `${SITE_URL}${path}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#121214" />
    <!-- Sets the theme before the page paints. Keep it first, and keep it a plain script (not a module). -->
    <script is:inline src="/theme.js"></script>
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={url} />}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={OG_IMAGE} />
    <meta property="og:image:alt" content={OG_IMAGE_ALT} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={FONTS} />
    <slot name="head" />
  </head>
  <body class="flex min-h-svh flex-col">
    <a class="skip" href="#main">Skip to the content</a>
    <Header page={page} />
    <main id="main" class:list={["relative grow", mainClass]}>
      <slot />
    </main>
    <Footer page={page} />
    <slot name="end" />
  </body>
</html>
